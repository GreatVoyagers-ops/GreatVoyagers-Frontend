# Get a free access key at https://web3forms.com using harshit.greatvoyagers@gmail.com.
# Every enquiry form submission is emailed to that address.
VITE_WEB3FORMS_KEY=

# Your live website address, used for canonical URLs, social previews and sitemap.xml
VITE_SITE_URL=https://www.greatvoyagers.com

# Browser calls this origin for /api. Leave empty locally (Vite proxies to the backend).
# On Hostinger set this to the API app, e.g. https://api.greatvoyagers.com
VITE_API_URL=

# Backend URL the build fetches posts from to prerender blog pages
PRERENDER_API_URL=http://localhost:5000
